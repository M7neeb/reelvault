            }
          },
          {
            "name": "Gold",
            "ios": "./assets/icons/gold.png",
            "android": {
              "foregroundImage": "./assets/icons/gold.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Mint",
            "ios": "./assets/icons/mint.png",
            "android": {
              "foregroundImage": "./assets/icons/mint.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Aurora",
            "ios": "./assets/icons/aurora.png",
