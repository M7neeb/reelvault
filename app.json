            }
          }
        ]
      ]
    ],
    "runtimeVersion": "1.10.0",
    "updates": {
      "url": "https://u.expo.dev/f9139cd3-bb87-46bf-8a97-a60c2665423d",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
