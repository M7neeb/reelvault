{
  "expo": {
    "name": "ReelVault",
    "slug": "reelvault",
    "version": "1.11.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "reelvault",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.muneeb.reelvault",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "ReelVault receives videos and audio you send from your computer over Wi-Fi.",
        "LSSupportsOpeningDocumentsInPlace": false,
        "UIFileSharingEnabled": true,
        "CADisableMinimumFrameDurationOnPhone": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Video",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["public.movie", "public.mpeg-4", "com.apple.quicktime-movie", "public.avi", "com.apple.m4v-video", "public.3gpp"]
          },
          {
            "CFBundleTypeName": "Audio",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["public.audio", "public.mp3", "public.mpeg-4-audio", "com.apple.m4a-audio", "com.apple.protected-mpeg-4-audio", "public.aac-audio", "com.microsoft.waveform-audio", "public.aiff-audio", "com.apple.coreaudio-format", "org.xiph.flac", "public.ogg-audio"]
          },
          {
            "CFBundleTypeName": "EPUB book",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["org.idpf.epub-container"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1016",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ReelVault uses Face ID to unlock your private videos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ReelVault imports the videos you pick from Photos.",
          "cameraPermission": "ReelVault films videos straight into your vault.",
          "microphonePermission": "ReelVault records sound with the videos you film."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A84FF"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "ReelVault imports the videos you pick from Photos.",
          "savePhotosPermission": "ReelVault saves the videos you choose to Photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Midnight",
            "ios": "./assets/icons/midnight.png",
            "android": {
              "foregroundImage": "./assets/icons/midnight.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Sunset",
            "ios": "./assets/icons/sunset.png",
            "android": {
              "foregroundImage": "./assets/icons/sunset.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Forest",
            "ios": "./assets/icons/forest.png",
            "android": {
              "foregroundImage": "./assets/icons/forest.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Mono",
            "ios": "./assets/icons/mono.png",
            "android": {
              "foregroundImage": "./assets/icons/mono.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Grape",
            "ios": "./assets/icons/grape.png",
            "android": {
              "foregroundImage": "./assets/icons/grape.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Classic",
            "ios": "./assets/icons/classic.png",
            "android": {
              "foregroundImage": "./assets/icons/classic.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Ocean",
            "ios": "./assets/icons/ocean.png",
            "android": {
              "foregroundImage": "./assets/icons/ocean.png",
              "backgroundColor": "#000000"
            }
          },
          {
